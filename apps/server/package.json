{
  "name": "@hr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Save_API: stores Profiles and Save_Documents, serves the built web app.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --packages=external",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@hr/shared": "0.1.0",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}

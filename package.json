{
  "name": "human-resource",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Human Resource - a toy-like corporate satire business game (PWA).",
  "workspaces": [
    "packages/content",
    "packages/sim",
    "packages/shared",
    "apps/web",
    "apps/server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @hr/web",
    "build": "npm run build --workspace @hr/web",
    "preview": "npm run preview --workspace @hr/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
